{
    "name": "backbone/php-activerecord",
    "type": "library",
    "description": "backbone/php-activerecord is an for of open source ORM library based on the ActiveRecord pattern.",
    "keywords": ["activerecord", "orm"],
    "homepage": "https://github.com/backbonesk/php-activerecord",
    "license": "MIT",
    "require": {
        "php": ">=5.3.0"
    },
    "autoload": {
        "psr-0": {
            "ActiveRecord": "lib/"
        },
        "files": [
            "lib/ActiveRecord/Utils.php",
            "lib/ActiveRecord/Exceptions.php"
        ]
    }
}
